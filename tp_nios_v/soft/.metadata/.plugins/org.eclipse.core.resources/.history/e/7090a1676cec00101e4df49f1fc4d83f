#include <stdio.h>
#include <unistd.h> // for usleep

#include "system.h"
#include "altera_avalon_pio_regs.h"

int main (void)
{
	printf("Hello, world! aller \r\n");

	short led_value = 0x1;

	while(1)
	{
		IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, led_value);

		led_value = led_value << 1;
		if (led_value == 0x1000000000) led_value = 0x1;

		usleep(500000);
	}

	return 0;
}
